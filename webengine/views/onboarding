<script type="module">
  $(document).ready(async function () {
    // Show loading indicator at the start
    $("#personalInfoLoading").removeClass("d-none");

    // Function to check for ZUID availability
    async function waitForZuid(maxAttempts = 30, interval = 1000) {
      for (let attempt = 1; attempt <= maxAttempts; attempt++) {
        const userData = JSON.parse(localStorage.getItem("user"));
        const zuid = userData?.zuid;

        if (zuid) {
          console.log(`ZUID found after ${attempt} attempts`);
          return zuid;
        }

        console.log(
          `ZUID not available yet, attempt ${attempt}/${maxAttempts}`
        );

        if (attempt < maxAttempts) {
          await new Promise((resolve) => setTimeout(resolve, interval));
        }
      }

      console.error("ZUID not available after maximum attempts");
      return null;
    }

    // Function to wait for TanStack Query functions to be available
    async function waitForQueryFunctions(maxAttempts = 30, interval = 100) {
      for (let attempt = 1; attempt <= maxAttempts; attempt++) {
        if (window.createCreateNpoMutation && typeof window.createCreateNpoMutation === 'function') {
          console.log(`TanStack Query functions loaded after ${attempt} attempts`);
          return true;
        }

        console.log(
          `TanStack Query functions not available yet, attempt ${attempt}/${maxAttempts}`
        );

        if (attempt < maxAttempts) {
          await new Promise((resolve) => setTimeout(resolve, interval));
        }
      }

      console.error("TanStack Query functions not available after maximum attempts");
      return false;
    }

    // Wait for ZUID to become available
    const zuid = await waitForZuid();

    if (!zuid) {
      console.error("Unable to proceed without ZUID");
      // Hide loading indicator even on error
      $("#personalInfoLoading").addClass("d-none");
      return;
    }

    // Wait for TanStack Query functions to be available
    const queryFunctionsReady = await waitForQueryFunctions();
    if (!queryFunctionsReady) {
      console.error("TanStack Query functions not available, some features may not work");
    }

    let userData = await window.getUserProfile(zuid); //first_name, last_name

    // Pre-populate personal info fields if user data exists
    if (userData?.data[0]) {
      const user = userData.data[0];
      if (user.first_name) $("#firstName").val(user.first_name);
      if (user.last_name) $("#lastName").val(user.last_name);
      if (user.email) $("#email").val(user.email).prop("disabled", true);
    }

    // Hide loading indicator after data is loaded
    $("#personalInfoLoading").addClass("d-none");

    async function updateUserProfile(zuid) {
      if (!userData?.data[0]) return;

      const currentUser = userData.data[0];
      const userZuid = zuid;

      // Edit the user data
      currentUser.user_type = selectedRole;

      // Add org data to currentUser object (but exclude from API call)
      if (isNPOFlow() && orgDetails) {
        currentUser.orgDetails = orgDetails;
      }
      // Sync orgMedia from window if it exists (set by orgMedia.html script)
      if (isNPOFlow() && window.orgMedia) {
        orgMedia = window.orgMedia;
      }
      if (isNPOFlow() && orgMedia) {
        currentUser.orgMedia = orgMedia;
      }

      // Handle existing favorite_causes if it's a relationship object
      if (
        currentUser.favorite_causes?.data &&
        Array.isArray(currentUser.favorite_causes.data)
      ) {
        // Extract existing ZUIDs that aren't in the selected list to preserve them
        const existingCauseZuids = currentUser.favorite_causes.data.map(
          (cause) => cause.meta.zuid
        );
        const preservedCauseZuids = existingCauseZuids.filter(
          (zuid) => !selectedCauses.includes(zuid)
        );

        // Combine preserved ZUIDs with newly selected ones
        currentUser.favorite_causes = [
          ...preservedCauseZuids,
          ...selectedCauses,
        ].join(",");
      } else {
        // If it's not a relationship object or doesn't exist, simply set the new value
        currentUser.favorite_causes = selectedCauses.join(",");
      }

      // Handle existing favorite_npos if it's a relationship object
      if (
        currentUser.favorite_npos?.data &&
        Array.isArray(currentUser.favorite_npos.data)
      ) {
        // Extract existing ZUIDs that aren't in the selected list to preserve them
        const existingNpoZuids = currentUser.favorite_npos.data.map(
          (npo) => npo.meta.zuid
        );
        const preservedNpoZuids = existingNpoZuids.filter(
          (zuid) => !selectedNPOs.includes(zuid)
        );

        // Combine preserved ZUIDs with newly selected ones
        currentUser.favorite_npos = [
          ...preservedNpoZuids,
          ...selectedNPOs,
        ].join(",");
      } else {
        // If it's not a relationship object or doesn't exist, simply set the new value
        currentUser.favorite_npos = selectedNPOs.join(",");
      }

      // Update user with the new data (exclude org data from API call)
      const updatedUser = await window.updateZestyUser(userZuid, {
        first_name: personalInfo.firstName,
        last_name: personalInfo.lastName,
        email: personalInfo.email,
        favorite_causes: currentUser.favorite_causes,
        favorite_npos: currentUser.favorite_npos,
        user_type: currentUser.user_type,
        isOnboarded: true,
      });
    }

    let currentStep = 1;
    let personalInfo = {
      firstName: "",
      lastName: "",
      email: "",
    };
    let selectedRole,
      selectedCauses = [],
      selectedNPOs = [],
      npoChoice = null, // 'add-npo' or 'customize-storyhub'
      orgDetails = null,
      orgMedia = null;
    
    // Multi-select cause filter state
    let selectedCauseZuidsForFilter = []; // Array of cause ZUIDs for filtering NPOs
    let persistentSelectedNPOsData = {}; // Object to store full NPO data for selected items (keyed by ZUID)

    // Helper function to determine if NPO flow should be used
    function isNPOFlow() {
      return selectedRole === 'volunteer' || selectedRole === 'staff';
    }

    // Define step arrays based on selected role and choices
    function getStepArray() {
      if (isNPOFlow()) {
        if (npoChoice === 'add-npo') {
          // Branch A: Add NPO flow
          return [
            "personalInfo",
            "roleSelection",
            "npoAdditionChoice",
            "orgDetails",
            "orgMedia",
            "orgReview",
            "causeSelection",
            "npoSelection"
          ];
        } else if (npoChoice === 'customize-storyhub') {
          // Branch B: Customize StoryHub flow
          return [
            "personalInfo",
            "roleSelection",
            "npoAdditionChoice",
            "causeSelection",
            "npoSelection"
          ];
        } else {
          // Before choice is made
          return [
            "personalInfo",
            "roleSelection",
            "npoAdditionChoice"
          ];
        }
      } else {
        // Regular flow
        return [
          "personalInfo",
          "roleSelection",
          "causeSelection",
          "npoSelection"
        ];
      }
    }

    function updateStepUI() {
      const stepArray = getStepArray();
      const currentStepId = stepArray[currentStep - 1];
      const totalSteps = stepArray.length;

      // Hide all sections
      $(
        "#personalInfo, #roleSelection, #npoAdditionChoice, #orgDetails, #orgMedia, #orgReview, #causeSelection, #npoSelection, #summary"
      ).addClass("d-none");

      // Show current step
      $(`#${currentStepId}`).removeClass("d-none");

      // Update prev/next buttons
      $(".prevBtn").toggleClass("d-none", currentStep === 1);
      $("#nextBtn").text(currentStep === totalSteps ? "Complete" : "Next");

      // Update steps indicator (if exists)
      $("#stepsIndicator .step-item").each(function () {
        const stepNumber = $(this).data("step");
        $(this).removeClass("active completed");
        if (stepNumber < currentStep) {
          $(this).addClass("completed");
          $(this).find(".step-icon").text("✓");
        } else if (stepNumber === currentStep) {
          $(this).addClass("active");
          $(this).find(".step-icon").text(stepNumber);
        } else {
          $(this).find(".step-icon").text(stepNumber);
        }
      });

      // Handle step-specific logic
      if (currentStepId === "causeSelection") {
        loadCauses();
      }
      if (currentStepId === "npoSelection") {
        // Initialize filter with all selected causes from causeSelection step
        selectedCauseZuidsForFilter = [...selectedCauses];
        loadCausesDropdown(selectedCauseZuidsForFilter);
        loadNPOs(selectedCauseZuidsForFilter);
      }
      if (currentStepId === "orgDetails") {
        loadCauseAreaDropdown();
      }
      if (currentStepId === "orgMedia") {
        // Initialize window.orgMedia if not already set
        if (!window.orgMedia) {
          window.orgMedia = orgMedia || { logo: null, coverImage: null };
        }
        if (orgDetails) {
          // Update org name and description display
          $("#orgNameDisplay").text(orgDetails.name || "Your NPO");
          $("#orgDescriptionDisplay").text(orgDetails.description || "Add a short description about your organization");
        }
      }
    }

    $(".role-card").click(function () {
      const $card = $(this);
      const $iconContainer = $card.find(".p-2.rounded-circle");
      const $img = $iconContainer.find("img");
      
      // Remove selected state from all role cards
      $(".role-card").each(function() {
        const $otherCard = $(this);
        const $otherIconContainer = $otherCard.find(".p-2.rounded-circle");
        const $otherImg = $otherIconContainer.find("img");
        const originalSrc = $otherCard.data("original-img-src");
        
        if ($otherCard.hasClass("selected") && originalSrc) {
          // Restore original image
          $otherIconContainer.html(`<img src="${originalSrc}" style="max-width: 40px" />`);
        }
        $otherCard.removeClass("selected");
      });
      
      // Store original image source if not already stored
      if (!$card.data("original-img-src")) {
        $card.data("original-img-src", $img.attr("src"));
      }
      
      // Replace image with purple box and check icon
      $iconContainer.html('<i class="bi bi-check text-white"></i>');
      $iconContainer.css({
        "background-color": "#7b3fee",
        "width": "40px",
        "height": "40px"
      });
      
      $card.addClass("selected");
      selectedRole = $card.data("role");
    });

    $(".nextBtn").click(async function () {
      const stepArray = getStepArray();
      const currentStepId = stepArray[currentStep - 1];
      const totalSteps = stepArray.length;
      const isLastStep = currentStep === totalSteps;

      // Validate personal info
      if (currentStepId === "personalInfo") {
        const firstName = $("#firstName").val().trim();
        const lastName = $("#lastName").val().trim();
        const email = $("#email").val().trim();

        if (!firstName || !lastName || !email) {
          alert("Please fill in all personal information fields");
          return;
        }

        if (!isValidEmail(email)) {
          alert("Please enter a valid email address");
          return;
        }

        personalInfo.firstName = firstName;
        personalInfo.lastName = lastName;
        personalInfo.email = email;
      }

      // Validate role selection
      if (currentStepId === "roleSelection" && !selectedRole) {
        alert("Please select a role");
        return;
      }

      // Validate NPO choice
      if (currentStepId === "npoAdditionChoice" && !npoChoice) {
        alert("Please select an option");
        return;
      }

      // Validate org details
      if (currentStepId === "orgDetails") {
        const npoName = $("#npoName").val().trim();
        const npoDescription = $("#npoDescription").val().trim();
        const causeAreaZuid = $("#causeArea").val().trim();
        const causeAreaName = $("#causeAreaInput").val().trim();
        const adminTerms = $("#adminTerms").is(":checked");

        if (!npoName || !npoDescription || !adminTerms) {
          alert("Please fill in all required fields and agree to the Admin Terms");
          return;
        }

        orgDetails = {
          name: npoName,
          description: npoDescription,
          causeArea: causeAreaName, // Store the name for display purposes
          causeAreaZuid: causeAreaZuid, // Store the ZUID for API purposes
          termsAccepted: adminTerms
        };
      }

      // Handle NPO creation when transitioning from orgMedia to orgReview
      if (currentStepId === "orgMedia") {
        const $nextBtn = $(".nextBtn");
        const originalBtnText = $nextBtn.html();
        
        try {
          // Set loading state
          $nextBtn.prop("disabled", true);
          $nextBtn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Creating organization...');
          
          // Clear any previous NPO creation errors
          window.npoCreationError = null;
          window.npoCreationData = null;
          
          let logoId = "";
          let heroImageId = "";
          
          // Upload images if they exist
          if (window.orgMedia) {
            // Upload logo if exists
            if (window.orgMedia.logo) {
              try {
                const logoResult = await window.newUploadImages([window.orgMedia.logo]);
                if (logoResult && logoResult.length > 0 && logoResult[0].data && logoResult[0].data[0]) {
                  logoId = logoResult[0].data[0].id;
                }
              } catch (error) {
                console.error("Error uploading logo:", error);
                // Continue without logo
              }
            }
            
            // Upload cover image if exists
            if (window.orgMedia.coverImage) {
              try {
                const heroResult = await window.newUploadImages([window.orgMedia.coverImage]);
                if (heroResult && heroResult.length > 0 && heroResult[0].data && heroResult[0].data[0]) {
                  heroImageId = heroResult[0].data[0].id;
                }
              } catch (error) {
                console.error("Error uploading cover image:", error);
                // Continue without cover image
              }
            }
          }
          
          // Create NPO using mutation
          if (!window.createCreateNpoMutation || typeof window.createCreateNpoMutation !== 'function') {
            throw new Error("TanStack Query functions not loaded. Please refresh the page.");
          }
          
          const createNpoMutation = window.createCreateNpoMutation();
          
          // Create a promise to wait for mutation result
          const npoCreationPromise = new Promise((resolve, reject) => {
            const unsubscribe = createNpoMutation.subscribe((result) => {
              if (result.status === 'success') {
                console.log("NPO created successfully:", result.data);
                // Store NPO creation data for later use
                window.npoCreationData = result.data;
                unsubscribe();
                resolve(result.data);
              } else if (result.status === 'error') {
                console.error("NPO creation failed:", result.error);
                window.npoCreationError = result.error.message || "Failed to create organization";
                unsubscribe();
                resolve(null); // Resolve with null to continue anyway
              }
            });
            
            // Trigger the mutation
            createNpoMutation.mutate({
              name: orgDetails.name,
              category: orgDetails.causeAreaZuid,
              cause_description: orgDetails.description,
              logo: logoId,
              hero_image: heroImageId,
              admins: zuid || ""
            });
          });
          
          // Wait for NPO creation to complete (or fail)
          await npoCreationPromise;
          
        } catch (error) {
          console.error("Error in NPO creation flow:", error);
          window.npoCreationError = error.message || "An unexpected error occurred";
          // Continue to orgReview anyway
        } finally {
          // Restore button state
          $nextBtn.prop("disabled", false);
          $nextBtn.html(originalBtnText);
        }
        
        // Proceed to next step (orgReview)
        if (currentStep < stepArray.length) {
          currentStep++;
          updateStepUI();
        }
        return;
      }

      // If this is the last step, update profile and redirect
      if (isLastStep) {
        const $nextBtn = $(".nextBtn");
        const originalBtnText = $nextBtn.html();
        
        // Set loading state
        $nextBtn.prop("disabled", true);
        $nextBtn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing...');
        
        const localUser = localStorage.getItem("user");
        if (localUser) {
          try {
            await updateUserProfile(JSON.parse(localUser).zuid);
            // Redirect to home feed after profile update completes
            window.location.replace("{{ home_feed.first().getUrl() }}");
          } catch (error) {
            console.error("Error updating user profile:", error);
            // Restore button state on error
            $nextBtn.prop("disabled", false);
            $nextBtn.html(originalBtnText);
            alert("There was an error completing your onboarding. Please try again.");
          }
        } else {
          // If no user in localStorage, still redirect (shouldn't happen normally)
          window.location.replace("{{ home_feed.first().getUrl() }}");
        }
        return;
      }

      // Move to next step
      if (currentStep < stepArray.length) {
        currentStep++;
        updateStepUI();
      }
    });

    $(".skipBtn").click(async function () {
      const stepArray = getStepArray();
      const currentStepId = stepArray[currentStep - 1];
      const totalSteps = stepArray.length;
      const isLastStep = currentStep === totalSteps;

      // Handle skip for orgMedia
      if (currentStepId === "orgMedia") {
        orgMedia = {
          logo: null,
          coverImage: null
        };
        window.orgMedia = orgMedia;
        
        // Create NPO without images when skipping orgMedia
        const $skipBtn = $(".skipBtn");
        const originalBtnText = $skipBtn.html();
        
        try {
          // Set loading state
          $skipBtn.prop("disabled", true);
          $skipBtn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Creating organization...');
          
          // Clear any previous NPO creation errors
          window.npoCreationError = null;
          window.npoCreationData = null;
          
          // Create NPO using mutation (without images)
          if (!window.createCreateNpoMutation || typeof window.createCreateNpoMutation !== 'function') {
            throw new Error("TanStack Query functions not loaded. Please refresh the page.");
          }
          
          const createNpoMutation = window.createCreateNpoMutation();
          
          // Create a promise to wait for mutation result
          const npoCreationPromise = new Promise((resolve, reject) => {
            const unsubscribe = createNpoMutation.subscribe((result) => {
              if (result.status === 'success') {
                console.log("NPO created successfully:", result.data);
                // Store NPO creation data for later use
                window.npoCreationData = result.data;
                unsubscribe();
                resolve(result.data);
              } else if (result.status === 'error') {
                console.error("NPO creation failed:", result.error);
                window.npoCreationError = result.error.message || "Failed to create organization";
                unsubscribe();
                resolve(null); // Resolve with null to continue anyway
              }
            });
            
            // Trigger the mutation
            createNpoMutation.mutate({
              name: orgDetails.name,
              category: orgDetails.causeAreaZuid,
              cause_description: orgDetails.description,
              logo: "",
              hero_image: "",
              admins: zuid || ""
            });
          });
          
          // Wait for NPO creation to complete (or fail)
          await npoCreationPromise;
          
        } catch (error) {
          console.error("Error in NPO creation flow:", error);
          window.npoCreationError = error.message || "An unexpected error occurred";
          // Continue to orgReview anyway
        } finally {
          // Restore button state
          $skipBtn.prop("disabled", false);
          $skipBtn.html(originalBtnText);
        }
        
        // Proceed to next step (orgReview)
        if (currentStep < stepArray.length) {
          currentStep++;
          updateStepUI();
        }
        return;
      }

      // If this is the last step, update profile and redirect
      if (isLastStep) {
        const $skipBtn = $(".skipBtn");
        const originalBtnText = $skipBtn.html();
        
        // Set loading state
        $skipBtn.prop("disabled", true);
        $skipBtn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing...');
        
        const localUser = localStorage.getItem("user");
        if (localUser) {
          try {
            await updateUserProfile(JSON.parse(localUser).zuid);
            // Redirect to home feed after profile update completes
            window.location.replace("{{ home_feed.first().getUrl() }}");
          } catch (error) {
            console.error("Error updating user profile:", error);
            // Restore button state on error
            $skipBtn.prop("disabled", false);
            $skipBtn.html(originalBtnText);
            alert("There was an error completing your onboarding. Please try again.");
          }
        } else {
          // If no user in localStorage, still redirect (shouldn't happen normally)
          window.location.replace("{{ home_feed.first().getUrl() }}");
        }
        return;
      }

      if (currentStep < stepArray.length) {
        currentStep++;
        updateStepUI();
      }
    });

    // Email validation function
    function isValidEmail(email) {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      return emailRegex.test(email);
    }

    $(".prevBtn").click(function () {
      if (currentStep > 1) {
        currentStep--;
        updateStepUI();
      }
    });

    // Handle NPO choice card clicks
    $(document).on("click", ".npo-choice-card", function () {
      const $card = $(this);
      const choice = $card.data("choice");

      // Remove selected state from all choice cards
      $(".npo-choice-card").removeClass("selected");

      // Add selected state to clicked card
      $card.addClass("selected");
      npoChoice = choice;

      // Auto-advance to next step
      setTimeout(() => {
        const stepArray = getStepArray();
        if (currentStep < stepArray.length) {
          currentStep++;
          updateStepUI();
        }
      }, 300);
    });

    // Handle org review action card clicks
    $(document).on("click", ".org-action-card", async function () {
      const $card = $(this);
      const action = $card.data("action");

      if (action === "manage-npo") {
        // Save user profile before redirecting to NPO management
        const localUser = localStorage.getItem("user");
        
        if (!localUser) {
          console.error("No user found in localStorage");
          alert("Unable to save your profile. Please try again.");
          return;
        }

        try {
          // Disable the card to prevent multiple clicks
          $card.css("pointer-events", "none").css("opacity", "0.6");
          
          // Show loading indicator with backdrop
          const $loadingIndicator = $(`
            <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="z-index: 9999; background-color: rgba(255, 255, 255, 0.9); min-height: 100vh;">
              <div class="d-flex flex-column align-items-center gap-3">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-dark mb-0 fw-medium">Saving your profile...</p>
              </div>
            </div>
          `);
          $("body").append($loadingIndicator);
          
          // Update user profile with current data
          await updateUserProfile(JSON.parse(localUser).zuid);
          
          // Remove loading indicator
          $loadingIndicator.remove();
          
          // Redirect to NPO website if available
          if (window.npoCreationData && window.npoCreationData.links && window.npoCreationData.links.website) {
            window.location.href = `${window.npoCreationData.links.website}admin`;
          } else {
            console.error("NPO website URL not available");
            alert("NPO profile URL not available. Please try again later.");
            $card.css("pointer-events", "auto").css("opacity", "1");
          }
        } catch (error) {
          console.error("Error saving user profile:", error);
          alert("There was an error saving your profile. Please try again.");
          
          // Re-enable the card
          $card.css("pointer-events", "auto").css("opacity", "1");
          
          // Remove loading indicator if it exists
          $(".position-fixed.top-50.start-50").remove();
        }
        return;
      } else if (action === "customize-storyhub") {
        // Remove selected state from all action cards
        $(".org-action-card").removeClass("selected");
        $card.addClass("selected");

        // Navigate to causeSelection
        const stepArray = getStepArray();
        const causeIndex = stepArray.indexOf("causeSelection");
        if (causeIndex !== -1) {
          currentStep = causeIndex + 1;
          updateStepUI();
        }
      }
    });

    // Handle description character counter
    $(document).on("input", "#npoDescription", function () {
      const length = $(this).val().length;
      $("#descriptionCharCount").text(length);
    });

    // Variables to store query observers and unsubscribe functions
    let nposQueryObserver = null;
    let nposUnsubscribe = null;
    let causesQueryObserver = null;
    let causesUnsubscribe = null;
    let causesDropdownQueryObserver = null;
    let causesDropdownUnsubscribe = null;
    let causeAreaDropdownQueryObserver = null;
    let causeAreaDropdownUnsubscribe = null;

    function loadCauses() {
      // Unsubscribe from previous query if exists
      if (causesUnsubscribe) {
        causesUnsubscribe();
        causesUnsubscribe = null;
      }

      // Show loading indicator
      $("#cause-loading").removeClass("d-none");
      $("#cause-container").addClass("d-none");

      // Create query observer
      causesQueryObserver = window.createAllCausesQuery({ limit: 9999, skip: 0 });

      // Helper function to render causes
      const renderCauses = (causes) => {
        const causeContainer = $("#cause-container");
        causeContainer.empty();

        causes.forEach((cause) => {
          const imageUrl =
            typeof cause.image === "string" && cause.image.trim() !== ""
              ? cause.image
              : cause.image && cause.image.data && cause.image.data[0]
              ? cause.image.data[0].url
              : "https://placehold.co/100x100";
          const description = cause.description
            ? cause.description.substring(0, 100) + "..."
            : "No description available";

          const isSelected = selectedCauses.includes(cause.zuid);

          const causeCard = `
            <div class="card cause-card ${isSelected ? 'selected' : ''}" data-cause-id="${cause.zuid}">
              <div class="d-flex gap-2 align-items-center p-3">
                ${isSelected 
                  ? '<div class="card-icon-container"><i class="bi bi-check"></i></div>'
                  : `<img src="${imageUrl}" alt="${cause.title}" style="width: 60px; height: 60px; object-fit: cover;">`
                }
                <div class="flex-grow-1">
                  <p class="fs-5 mb-0 cause-title" style="font-size: 14px">${cause.title}</p>
                  <div class="text-muted mb-0 cause-description" style="font-size: 12px">${description}</div>
                </div>
              </div>
            </div>
          `;
          const $card = $(causeCard);
          if (isSelected) {
            $card.data("original-img-src", imageUrl);
          }
          causeContainer.append($card);
        });

        // Update button state based on current selections
        if (selectedCauses.length > 0) {
          $(".selectedCauses-btn").removeClass("d-none");
          $(".skipBtn").addClass("d-none");
        } else {
          $(".selectedCauses-btn").addClass("d-none");
          $(".skipBtn").removeClass("d-none");
        }

        // Add click event for cause selection
        $(".cause-card").click(function () {
          const $card = $(this);
          const causeId = $card.data("cause-id");
          const $img = $card.find("img");
          const originalSrc = $card.data("original-img-src") || $img.attr("src");
          
          // Store original image source if not already stored
          if (!$card.data("original-img-src")) {
            $card.data("original-img-src", originalSrc);
          }
          
          $card.toggleClass("selected"); // Toggle selection on click
          if ($card.hasClass("selected")) {
            // Replace image with purple box and check icon
            if ($img.length) {
              $img.replaceWith(`
                <div class="card-icon-container">
                  <i class="bi bi-check"></i>
                </div>
              `);
            }
            if (!selectedCauses.includes(causeId)) {
              selectedCauses.push(causeId); // Add to selected causes
            }
          } else {
            // Restore original image
            $card.find(".card-icon-container").replaceWith(`<img src="${originalSrc}" alt="${$card.find('.cause-title').text()}" style="width: 60px; height: 60px; object-fit: cover;">`);
            selectedCauses = selectedCauses.filter((id) => id !== causeId); // Remove from selected causes
          }

          if (selectedCauses.length > 0) {
            $(".selectedCauses-btn").removeClass("d-none");
            $(".skipBtn").addClass("d-none");
          } else {
            $(".selectedCauses-btn").addClass("d-none");
            $(".skipBtn").removeClass("d-none");
          }
        });

        // Hide loading indicator and show results
        $("#cause-loading").addClass("d-none");
        $("#cause-container").removeClass("d-none");
      };

      // Check for cached result immediately
      const cachedResult = causesQueryObserver.getCurrentResult();
      if (cachedResult && cachedResult.status === 'success' && cachedResult.data) {
        const causes = cachedResult.data.data || [];
        renderCauses(causes);
      }

      // Subscribe to query state changes for future updates
      causesUnsubscribe = causesQueryObserver.subscribe((result) => {
        if (result.status === 'pending') {
          // Show loading state
          $("#cause-loading").removeClass("d-none");
          $("#cause-container").addClass("d-none");
          return;
        }

        if (result.status === 'success' && result.data) {
          const causes = result.data.data || [];
          renderCauses(causes);
        } else if (result.status === 'error') {
          console.error("Error fetching causes:", result.error);
          // Hide loading indicator on error
          $("#cause-loading").addClass("d-none");
          $("#cause-container").removeClass("d-none");
        }
      });
    }

    function loadCausesDropdown(preselectedCauseZuids = []) {
      const dropdown = $("#causeFilterDropdown");
      const input = $("#causeFilterInput");
      
      // Ensure dropdown exists
      if (dropdown.length === 0) {
        console.warn("Cause filter dropdown not found");
        return;
      }

      // Always keep input showing "Choose one"
      input.val("Choose one");

      // Unsubscribe from previous query if exists
      if (causesDropdownUnsubscribe) {
        causesDropdownUnsubscribe();
        causesDropdownUnsubscribe = null;
      }

      // Create query observer
      causesDropdownQueryObserver = window.createAllCausesQuery({ limit: 9999, skip: 0 });

      // Initialize selectedCauseZuidsForFilter with preselected causes on first load
      if (preselectedCauseZuids.length > 0 && selectedCauseZuidsForFilter.length === 0) {
        selectedCauseZuidsForFilter = [...preselectedCauseZuids];
        $("#selectedCauseZuids").val(selectedCauseZuidsForFilter.join(","));
      }

      // Helper function to populate dropdown
      const populateDropdown = (causes) => {
        if (!causes || causes.length === 0) {
          console.warn("No causes found to populate dropdown");
          return;
        }
        
        // Clear existing items
        dropdown.empty();

        // Populate dropdown with causes (multi-select with checkboxes)
        causes.forEach((cause) => {
          const listItem = $("<li></li>");
          const isSelected = selectedCauseZuidsForFilter.includes(cause.zuid);
          
          const label = $("<label></label>")
            .attr("class", "dropdown-item d-flex align-items-center gap-2 mb-0")
            .css("cursor", "pointer");
          
          const checkbox = $("<input>")
            .attr("type", "checkbox")
            .attr("class", "form-check-input m-0")
            .attr("data-cause-zuid", cause.zuid)
            .prop("checked", isSelected);
          
          const text = $("<span></span>")
            .text(cause.title)
            .addClass("text-truncate");
          
          label.append(checkbox).append(text);
          listItem.append(label);
          dropdown.append(listItem);
        });
      };

      // Check for cached result immediately
      const cachedResult = causesDropdownQueryObserver.getCurrentResult();
      if (cachedResult && cachedResult.status === 'success' && cachedResult.data) {
        const causes = cachedResult.data.data || [];
        populateDropdown(causes);
      }

      // Subscribe to query state changes
      causesDropdownUnsubscribe = causesDropdownQueryObserver.subscribe((result) => {
        console.log("Causes dropdown query result:", result.status);
        if (result.status === 'success' && result.data) {
          const causes = result.data.data || [];
          populateDropdown(causes);
        } else if (result.status === 'error') {
          console.error("Error fetching causes for dropdown:", result.error);
        }
      });

      // Handle input click/focus to show dropdown (unbind first to prevent duplicates)
      input.off("click.causeFilter focus.causeFilter").on("click.causeFilter focus.causeFilter", function() {
        if (dropdown.children().length > 0) {
          dropdown.show();
        }
      });

      // Handle checkbox change for multi-select (unbind first to prevent duplicates)
      dropdown.off("change.causeFilter", "input[type='checkbox']").on("change.causeFilter", "input[type='checkbox']", function(e) {
        const causeZuid = $(this).data("cause-zuid") || "";
        const isChecked = $(this).prop("checked");

        // Toggle cause in selectedCauseZuidsForFilter array
        if (isChecked && !selectedCauseZuidsForFilter.includes(causeZuid)) {
          // Add to array
          selectedCauseZuidsForFilter.push(causeZuid);
        } else if (!isChecked && selectedCauseZuidsForFilter.includes(causeZuid)) {
          // Remove from array
          selectedCauseZuidsForFilter = selectedCauseZuidsForFilter.filter(id => id !== causeZuid);
        }

        // Update hidden field
        $("#selectedCauseZuids").val(selectedCauseZuidsForFilter.join(","));
        
        // Reload NPOs with updated filter
        loadNPOs(selectedCauseZuidsForFilter);
        
        // Keep input text as "Choose one"
        input.val("Choose one");
      });

      // Handle input blur (with delay to allow dropdown clicks)
      input.off("blur.causeFilter").on("blur.causeFilter", function(e) {
        setTimeout(function() {
          if (!$(document.activeElement).closest('#causeFilterDropdown').length) {
            dropdown.hide();
          }
        }, 150);
      });

      // Prevent dropdown from closing when clicking on labels/checkboxes
      dropdown.off("click.preventClose").on("click.preventClose", function(e) {
        e.stopPropagation();
      });
    }

    function loadCauseAreaDropdown() {
      const dropdown = $("#causeAreaDropdown");
      const input = $("#causeAreaInput");
      
      // Ensure dropdown exists
      if (dropdown.length === 0) {
        console.warn("Cause area dropdown not found");
        return;
      }

      // Unsubscribe from previous query if exists
      if (causeAreaDropdownUnsubscribe) {
        causeAreaDropdownUnsubscribe();
        causeAreaDropdownUnsubscribe = null;
      }

      // Create query observer
      causeAreaDropdownQueryObserver = window.createAllCausesQuery({ limit: 9999, skip: 0 });

      // Helper function to populate dropdown
      const populateDropdown = (causes) => {
        if (!causes || causes.length === 0) {
          console.warn("No causes found to populate dropdown");
          return;
        }
        
        // Clear existing items
        dropdown.empty();
        const currentSelectedZuid = $("#causeArea").val();

        // Populate dropdown with causes
        causes.forEach((cause) => {
          const listItem = $("<li></li>");
          const isSelected = currentSelectedZuid === cause.zuid;
          const link = $("<a></a>")
            .attr("class", `dropdown-item ${isSelected ? 'active' : ''}`)
            .attr("href", "#")
            .attr("data-cause-zuid", cause.zuid)
            .text(cause.title)
            .addClass("text-truncate");
          if (isSelected) {
            link.append(' <i class="bi bi-check"></i>');
          }
          listItem.append(link);
          dropdown.append(listItem);
        });
      };

      // Check for cached result immediately
      const cachedResult = causeAreaDropdownQueryObserver.getCurrentResult();
      if (cachedResult && cachedResult.status === 'success' && cachedResult.data) {
        const causes = cachedResult.data.data || [];
        populateDropdown(causes);
      }

      // Subscribe to query state changes
      causeAreaDropdownUnsubscribe = causeAreaDropdownQueryObserver.subscribe((result) => {
        console.log("Cause area dropdown query result:", result.status);
        if (result.status === 'success' && result.data) {
          const causes = result.data.data || [];
          populateDropdown(causes);
        } else if (result.status === 'error') {
          console.error("Error fetching causes for dropdown:", result.error);
        }
      });

      // Handle input click/focus to show dropdown (unbind first to prevent duplicates)
      input.off("click.causeArea focus.causeArea").on("click.causeArea focus.causeArea", function() {
        if (dropdown.children().length > 0) {
          dropdown.show();
        }
      });

      // Handle dropdown item click (unbind first to prevent duplicates)
      dropdown.off("click.causeArea", "a.dropdown-item").on("click.causeArea", "a.dropdown-item", function(e) {
        e.preventDefault();
        const causeZuid = $(this).data("cause-zuid") || "";
        const causeName = $(this).text();

        // Update input and hidden field
        input.val(causeName);
        $("#causeArea").val(causeZuid);
        dropdown.hide();
        
        // Repopulate dropdown to update visual state
        const cachedResult = causeAreaDropdownQueryObserver.getCurrentResult();
        if (cachedResult && cachedResult.status === 'success' && cachedResult.data) {
          const causes = cachedResult.data.data || [];
          populateDropdown(causes);
        }
      });

      // Handle input blur (with delay to allow dropdown clicks)
      input.off("blur.causeArea").on("blur.causeArea", function(e) {
        setTimeout(function() {
          if (!$(document.activeElement).closest('#causeAreaDropdown').length) {
            dropdown.hide();
          }
        }, 150);
      });
    }

    function loadNPOs(causeZuids = []) {
      // Unsubscribe from previous queries if they exist
      if (nposUnsubscribe) {
        if (Array.isArray(nposUnsubscribe)) {
          nposUnsubscribe.forEach(unsub => unsub());
        } else {
          nposUnsubscribe();
        }
        nposUnsubscribe = null;
      }

      // Show loading indicator
      $("#npo-loading").removeClass("d-none");
      $("#npo-container").addClass("d-none");

      // Helper function to render NPOs
      const renderNPOs = (npos) => {
        const npoContainer = $("#npo-container");
        npoContainer.empty();

        // Check for empty NPO results when cause filters are active
        if (npos.length === 0 && causeZuids.length > 0) {
          const emptyMessage = `
            <div class="text-center py-4">
              <i class="bi bi-search" style="font-size: 48px; color: #ccc;"></i>
              <p class="text-muted mt-3">No nonprofits found for the selected cause areas</p>
              <p class="text-muted small">Try selecting different causes from the filter above</p>
            </div>
          `;
          npoContainer.html(emptyMessage);
          // Still hide loading, show container
          $("#npo-loading").addClass("d-none");
          $("#npo-container").removeClass("d-none");
          return; // Exit early
        }

        npos.forEach((npo) => {
          const imageUrl =
            npo.logo && npo.logo.data && npo.logo.data[0]
              ? npo.logo.data[0].url
              : "https://placehold.co/100x100";
          const description = npo.cause_description
            ? npo.cause_description.substring(0, 100) + "..."
            : "No description available";

          const npoId = npo.meta.zuid;
          const isSelected = selectedNPOs.includes(npoId);

          const npoCard = `
            <div class="card npo-card ${isSelected ? 'selected' : ''}" data-npo-id="${npoId}">
              <div class="d-flex gap-2 align-items-center p-3">
                ${isSelected 
                  ? '<div class="card-icon-container"><i class="bi bi-check"></i></div>'
                  : `<img src="${imageUrl}" alt="${npo.name}" style="width: 60px; height: 60px; object-fit: cover;">`
                }
                <div class="card-content">
                  <p class="fs-5 mb-0 cause-title" style="font-size: 14px">${npo.name}</p>
                  <div class="text-muted mb-0 cause-description" style="font-size: 12px">${description}</div>
                </div>
              </div>
            </div>
          `;
          const $card = $(npoCard);
          if (isSelected) {
            $card.data("original-img-src", imageUrl);
          }
          npoContainer.append($card);
        });

        // Add click event for NPO selection
        $(".npo-card").click(function () {
          const $card = $(this);
          const npoId = $card.data("npo-id");
          const $img = $card.find("img");
          const originalSrc = $card.data("original-img-src") || $img.attr("src");
          
          // Store original image source if not already stored
          if (!$card.data("original-img-src")) {
            $card.data("original-img-src", originalSrc);
          }
          
          $card.toggleClass("selected");
          if ($card.hasClass("selected")) {
            // Replace image with purple box and check icon
            if ($img.length) {
              $img.replaceWith(`
                <div class="card-icon-container">
                  <i class="bi bi-check"></i>
                </div>
              `);
            }
            if (!selectedNPOs.includes(npoId)) {
              selectedNPOs.push(npoId);
              // Store NPO data in persistent storage for later retrieval
              const npoData = npos.find(n => n.meta.zuid === npoId);
              if (npoData) {
                persistentSelectedNPOsData[npoId] = npoData;
              }
            }
          } else {
            // Restore original image
            $card.find(".card-icon-container").replaceWith(`<img src="${originalSrc}" alt="${$card.find('.cause-title').text()}" style="width: 60px; height: 60px; object-fit: cover;">`);
            selectedNPOs = selectedNPOs.filter((id) => id !== npoId);
            // Remove from persistent storage if not in current filter
            const npoInCurrentResults = npos.some(n => n.meta.zuid === npoId);
            if (!npoInCurrentResults) {
              delete persistentSelectedNPOsData[npoId];
            }
          }

          if (selectedNPOs.length > 0) {
            $(".selectedNPOs-btn").removeClass("d-none");
            $(".skipBtn").addClass("d-none");
          } else {
            $(".selectedNPOs-btn").addClass("d-none");
            $(".skipBtn").removeClass("d-none");
          }
        });

        // Update button state based on current selections
        if (selectedNPOs.length > 0) {
          $(".selectedNPOs-btn").removeClass("d-none");
          $(".skipBtn").addClass("d-none");
        } else {
          $(".selectedNPOs-btn").addClass("d-none");
          $(".skipBtn").removeClass("d-none");
        }

        // Hide loading indicator and show results
        $("#npo-loading").addClass("d-none");
        $("#npo-container").removeClass("d-none");
      };

      // If no cause filters, load all claimed NPOs
      if (causeZuids.length === 0) {
        const options = {
          limit: 25,
          page: 1,
          claimed: '1'
        };
        
        nposQueryObserver = window.createSearchNposQuery('', options);
        
        // Check for cached result immediately
        const cachedResult = nposQueryObserver.getCurrentResult();
        if (cachedResult && cachedResult.status === 'success' && cachedResult.data) {
          const npos = cachedResult.data.data || [];
          // Merge with persistent selected NPOs
          const mergedNpos = mergeWithPersistentNPOs(npos);
          renderNPOs(mergedNpos);
        }
        
        // Subscribe to query state changes
        nposUnsubscribe = nposQueryObserver.subscribe((result) => {
          if (result.status === 'pending') {
            $("#npo-loading").removeClass("d-none");
            $("#npo-container").addClass("d-none");
            return;
          }
          
          if (result.status === 'success' && result.data) {
            const npos = result.data.data || [];
            // Merge with persistent selected NPOs
            const mergedNpos = mergeWithPersistentNPOs(npos);
            renderNPOs(mergedNpos);
          } else if (result.status === 'error') {
            console.error("Error fetching NPOs:", result.error);
            $("#npo-loading").addClass("d-none");
            $("#npo-container").removeClass("d-none");
          }
        });
      } else {
        // Multiple cause filters - create parallel queries
        const queryObservers = causeZuids.map(causeZuid => {
          const options = {
            limit: 25,
            page: 1,
            claimed: '1',
            cause_zuid: causeZuid
          };
          return window.createSearchNposQuery('', options);
        });
        
        // Track query states
        let queryResults = new Array(queryObservers.length).fill(null);
        let queryStates = new Array(queryObservers.length).fill('pending');
        
        // Helper function to check if all queries are done
        const checkAndRender = () => {
          const allDone = queryStates.every(state => state === 'success' || state === 'error');
          if (allDone) {
            // Merge and deduplicate results from all queries
            const allNpos = queryResults.filter(result => result !== null).flat();
            const deduplicatedNpos = deduplicateNPOs(allNpos);
            // Merge with persistent selected NPOs
            const mergedNpos = mergeWithPersistentNPOs(deduplicatedNpos);
            renderNPOs(mergedNpos);
          }
        };
        
        // Check cached results immediately
        let hasCachedResults = false;
        queryObservers.forEach((observer, index) => {
          const cachedResult = observer.getCurrentResult();
          if (cachedResult && cachedResult.status === 'success' && cachedResult.data) {
            queryResults[index] = cachedResult.data.data || [];
            queryStates[index] = 'success';
            hasCachedResults = true;
          }
        });
        
        if (hasCachedResults) {
          checkAndRender();
        }
        
        // Subscribe to all query observers
        const unsubscribes = queryObservers.map((observer, index) => {
          return observer.subscribe((result) => {
            if (result.status === 'success' && result.data) {
              queryResults[index] = result.data.data || [];
              queryStates[index] = 'success';
              checkAndRender();
            } else if (result.status === 'error') {
              console.error(`Error fetching NPOs for cause ${causeZuids[index]}:`, result.error);
              queryResults[index] = [];
              queryStates[index] = 'error';
              checkAndRender();
            }
          });
        });
        
        nposUnsubscribe = unsubscribes;
      }
    }
    
    // Helper function to deduplicate NPOs by ZUID
    function deduplicateNPOs(npos) {
      const npoMap = new Map();
      npos.forEach(npo => {
        const zuid = npo.meta.zuid;
        if (!npoMap.has(zuid)) {
          npoMap.set(zuid, npo);
        }
      });
      return Array.from(npoMap.values());
    }
    
    // Helper function to merge with persistent selected NPOs
    function mergeWithPersistentNPOs(currentNpos) {
      const npoMap = new Map();
      
      // Add all current NPOs
      currentNpos.forEach(npo => {
        npoMap.set(npo.meta.zuid, npo);
      });
      
      // Add persistent selected NPOs that aren't already in current results
      Object.keys(persistentSelectedNPOsData).forEach(zuid => {
        if (!npoMap.has(zuid) && selectedNPOs.includes(zuid)) {
          npoMap.set(zuid, persistentSelectedNPOsData[zuid]);
        }
      });
      
      return Array.from(npoMap.values());
    }

    // Cause filter dropdown change is now handled in loadCausesDropdown() 
    // via the dropdown item click handler

    function showSummary() {
      const summaryContent = $("#summaryContent");
      summaryContent.empty();

      // Add role summary
      summaryContent.append(`<h3>Selected Role</h3><p>${selectedRole}</p>`);

      // Add causes summary
      summaryContent.append(`<h3>Selected Causes</h3>`);
      if (selectedCauses.length > 0) {
        const causesList = selectedCauses
          .map((causeId) => {
            const causeElement = $(`.cause-card[data-cause-id="${causeId}"]`);
            return causeElement.find(".fs-5").text();
          })
          .join(", ");
        summaryContent.append(`<p>${causesList}</p>`);
      } else {
        summaryContent.append(`<p>No causes selected</p>`);
      }

      // Add NPOs summary
      summaryContent.append(`<h3>Selected NPOs</h3>`);
      if (selectedNPOs.length > 0) {
        const nposList = selectedNPOs
          .map((npoId) => {
            const npoElement = $(`.npo-card[data-npo-id="${npoId}"]`);
            return npoElement.find(".fs-5").text();
          })
          .join(", ");
        summaryContent.append(`<p>${nposList}</p>`);
      } else {
        summaryContent.append(`<p>No NPOs selected</p>`);
      }
    }

    // Add a click handler for the complete button
    $(".completeBtn").click(function () {
      // Handle completion
    });

    // Initial UI update
    updateStepUI();

    // Handle click outside to close cause filter dropdown
    $(document).on("click.causeFilter", function(e) {
      const dropdown = $("#causeFilterDropdown");
      const input = $("#causeFilterInput");
      if (!$(e.target).closest('#causeFilterDropdown, #causeFilterInput').length && dropdown.is(":visible")) {
        dropdown.hide();
      }
    });

    // Handle click outside to close cause area dropdown
    $(document).on("click.causeArea", function(e) {
      const dropdown = $("#causeAreaDropdown");
      const input = $("#causeAreaInput");
      if (!$(e.target).closest('#causeAreaDropdown, #causeAreaInput').length && dropdown.is(":visible")) {
        dropdown.hide();
      }
    });

    const claimListingRedirectUrl = localStorage.getItem(
      "claimListingRedirectUrl"
    );

    if (claimListingRedirectUrl) {
      $("#createContentBtn")
        .attr("href", claimListingRedirectUrl + "?claim-listing-redirect=true")
        .text("Return to Claim Listing");
    }

    localStorage.removeItem("claimListingRedirectUrl");
  });
