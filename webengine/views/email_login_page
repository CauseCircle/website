<style>
  .email-login-page {
    min-height: 100vh;
    background-color: #fff;
  }
  .email-login-navbar {
    background-color: #fff;
    padding: 1.25rem 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    /* border-bottom: 1px solid #f0f0f0; */
  }
  .email-login-content { 
    max-width: 500px;
    width: 100%;
    padding: 3rem 1.5rem;
    margin: 0 auto;
  }
  .email-login-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ede9fe 0%, #e0e7ff 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }
  .email-login-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* padding: 14px; */
  }
  .email-login-icon i {
    font-size: 24px;
    color: #7c3aed;
  }
  .email-login-btn {
    height: 2.75rem;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .email-login-btn:disabled {
    background-color: #f3f4f6;
    border-color: #f3f4f6;
    color: #9ca3af;
  }
  .email-login-btn:not(:disabled) {
    background-color: #7c3aed;
    border-color: #7c3aed;
    color: #fff;
  }
  .email-login-btn:not(:disabled):hover {
    background-color: #6d28d9;
    border-color: #6d28d9;
  }
  .resend-btn {
    height: 2.75rem;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    background-color: #fff;
    font-weight: 500;
    color: #374151;
    transition: all 0.2s ease;
  }
  .resend-btn:hover:not(:disabled) {
    background-color: #f9fafb;
    border-color: #d1d5db;
  }
  .resend-btn:disabled {
    opacity: 0.6;
  }
  .email-highlight {
    font-weight: 600;
    color: #111827;
  }
  .resent-text {
    /* color: #7c3aed; */
    font-size: 0.875rem;
  }
  .form-control:focus {
    border-color: #7c3aed;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
  }
</style>

<div class="email-login-page">
  <!-- Navbar with centered logo -->
  <nav class="email-login-navbar">
    <a href="/">
      <img
        src="{{ globals.logo.getImage() }}?width=160&quality=60&format=webp"
        srcset="
          {{ globals.logo.getImage() }}?width=160&quality=60&format=webp 160w,
          {{ globals.logo.getImage() }}?width=140&quality=60&format=webp 140w"
        sizes="160px"
        style="max-width: 160px"
        width="160"
        decoding="async"
        fetchpriority="high"
        alt="CauseCircle logo"
        data-image-type="cc_logo"
      />
    </a>
  </nav>

  <!-- Main content -->
  <div class="email-login-content">
    <!-- Step 1: Email Form -->
    <div id="email-form-step">
      <div class="email-login-icon">
        <img src="https://4xxglxlj.media.zestyio.com/link.svg" alt="Link" width="64" height="64" />
      </div>
      <h4 class="text-center fw-semibold mb-2">Enter your email address</h4>
      <p class="text-center text-muted mb-4">
        We will send a link to your email to sign into your account.
      </p>
      <form id="magic-link-form">
        <label for="magic-link-email" class="form-label small fw-medium text-secondary">Email Address</label>
        <input
          type="email"
          id="magic-link-email"
          class="form-control mb-4"
          placeholder="Email address"
          required
          style="height: 2.75rem; border-radius: 8px; border: 1px solid #e5e7eb"
        />
        <button
          type="submit"
          class="btn email-login-btn w-100"
          id="get-magic-link-btn"
          disabled
        >
          Get Magic Link
        </button>
      </form>
      <div id="form-error" class="text-danger text-center mt-3 small d-none"></div>
    </div>

    <!-- Step 2: Email Sent Confirmation -->
    <div id="email-sent-step" class="d-none">
      <div class="email-login-icon">
        <img src="https://4xxglxlj.media.zestyio.com/email.svg" alt="Email" width="64" height="64" />
      </div>
      <h4 class="text-center fw-semibold mb-2">We are sending you an email</h4>
      <p class="text-center text-muted mb-4">
        We sent an email to <span id="sent-email-address" class="email-highlight"></span>. 
        You should see an email with a link to complete signup within the next 20 minutes. 
        Please check your spam or promotions folder. If you don't receive an email, resend the link below.
      </p>
      <button
        type="button"
        class="btn resend-btn w-100"
        id="resend-link-btn"
      >
        Resend Link
      </button>
      <div id="resent-confirmation" class="text-center mt-3 resent-text text-muted d-none">
        Link resent
      </div>
    </div>
  </div>
</div>

<script type="module">
  $(document).ready(function() {
    const $emailInput = $('#magic-link-email');
    const $submitBtn = $('#get-magic-link-btn');
    const $formStep = $('#email-form-step');
    const $sentStep = $('#email-sent-step');
    const $sentEmailAddress = $('#sent-email-address');
    const $resendBtn = $('#resend-link-btn');
    const $resentConfirmation = $('#resent-confirmation');
    const $formError = $('#form-error');

    let currentEmail = '';

    // Enable/disable button based on email input
    $emailInput.on('input', function() {
      const email = $(this).val().trim();
      const isValid = email.length > 0 && email.includes('@');
      $submitBtn.prop('disabled', !isValid);
    });

    // Handle form submission
    $('#magic-link-form').on('submit', async function(e) {
      e.preventDefault();
      
      currentEmail = $emailInput.val().trim();
      if (!currentEmail) return;

      // Show loading state
      $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Sending...');
      $formError.addClass('d-none');

      try {
        const result = await window.sendMagicLink(currentEmail);
        
        if (result.success) {
          // Show email sent step
          $sentEmailAddress.text(currentEmail);
          $formStep.addClass('d-none');
          $sentStep.removeClass('d-none');
          $resentConfirmation.addClass('d-none');
        } else {
          $formError.text(result.message || 'Failed to send link. Please try again.').removeClass('d-none');
          $submitBtn.prop('disabled', false).text('Get Magic Link');
        }
      } catch (error) {
        $formError.text('An error occurred. Please try again.').removeClass('d-none');
        $submitBtn.prop('disabled', false).text('Get Magic Link');
      }
    });

    // Handle resend button with 60 second cooldown
    let resendCooldown = 0;
    let cooldownInterval = null;

    const startCooldown = () => {
      resendCooldown = 60;
      $resendBtn.prop('disabled', true);
      updateCooldownText();
      
      cooldownInterval = setInterval(() => {
        resendCooldown--;
        if (resendCooldown <= 0) {
          clearInterval(cooldownInterval);
          $resendBtn.prop('disabled', false).text('Resend Link');
          $resentConfirmation.addClass('d-none'); // Hide "Link resent" when available again
        } else {
          updateCooldownText();
        }
      }, 1000);
    };

    const updateCooldownText = () => {
      $resendBtn.text(`Resend Link (${resendCooldown}s)`);
    };

    $resendBtn.on('click', async function() {
      if (!currentEmail || resendCooldown > 0) return;

      // Show loading state
      $resendBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Sending...');
      $resentConfirmation.addClass('d-none');

      try {
        const result = await window.sendMagicLink(currentEmail);
        
        if (result.success) {
          $resentConfirmation.removeClass('d-none');
          startCooldown();
        } else {
          $resendBtn.prop('disabled', false).text('Resend Link');
        }
      } catch (error) {
        console.error('Error resending link:', error);
        $resendBtn.prop('disabled', false).text('Resend Link');
      }
    });
  });
</script>
